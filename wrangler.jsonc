{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yea-or-nay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yea-or-nay-db",
      "database_id": "ad4bb80d-3a16-4ef9-9c9f-ff9c2919e1dc",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ICONS",
      "bucket_name": "yea-or-nay-room-icons"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "yea-or-nay-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yea-or-nay-staging-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ICONS",
          "bucket_name": "yea-or-nay-staging-room-icons"
        }
      ],
      "triggers": {
        "crons": ["0 3 * * *"]
      },
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api",
          "/api/*",
          "/room-icons/*",
          "/profile-photos/*",
          "/privacy.html",
          "/terms.html"
        ],
        "binding": "ASSETS",
        "directory": "./dist/client"
      }
    }
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/room-icons/*",
      "/profile-photos/*",
      "/privacy.html",
      "/terms.html"
    ],
    "binding": "ASSETS",
    "directory": "./dist/client"
  }
}
