{
  "name": "yea-or-nay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "npm run build:static",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:static",
    "build:static": "node scripts/build-static.mjs",
    "db:local": "wrangler d1 migrations apply yea-or-nay-db --local",
    "db:remote": "wrangler d1 migrations apply yea-or-nay-db --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "dev:staging": "npm run build:static && wrangler dev --env staging",
    "test": "node --test scripts/*.test.mjs",
    "db:staging:local": "wrangler d1 migrations apply DB --local --env staging"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  }
}
