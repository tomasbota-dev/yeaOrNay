{
  "name": "yea-or-nay",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "npm run build:static",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:static",
    "build:static": "vite build && node scripts/prerender.mjs",
    "db:local": "wrangler d1 migrations apply yea-or-nay-db --local",
    "db:remote": "wrangler d1 migrations apply yea-or-nay-db --remote",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json",
    "dev:staging": "npm run build:static && wrangler dev --env staging",
    "test": "node --test scripts/*.test.mjs",
    "db:staging:local": "wrangler d1 migrations apply DB --local --env staging",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run build:static"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "typescript": "^5.9.3",
    "undici": "7.30.1",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
